<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="lvglConverter.MainWindow"
        Title="Map Tiles Converter V1.0 (For LVGL)" Height="360" Width="640" MinHeight="280" MinWidth="480">
    <Window.Resources>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="8,4"/>
        </Style>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>     <!-- 0 folder -->
            <RowDefinition Height="Auto"/>     <!-- 1 type + ignore -->
            <RowDefinition Height="Auto"/>     <!-- 2 start -->
            <RowDefinition Height="Auto"/>     <!-- 3 handle -->
            <RowDefinition Height="Auto"/>     <!-- 4 status tip -->
            <RowDefinition Height="*"/>        <!-- 5 spacer -->
            <RowDefinition Height="Auto"/>     <!-- 6 progress -->
        </Grid.RowDefinitions>

        <!-- Folder path selection -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Folder:" Style="{StaticResource SectionLabel}"/>
        <TextBox Grid.Row="0" Grid.Column="1" x:Name="txtFolderPath" Margin="4,4" ToolTip="Folder containing numbered subfolders of PNG map tiles"/>
        <Button Grid.Row="0" Grid.Column="1" x:Name="btnSelectFolder" Content="Select Folder ..." HorizontalAlignment="Right" Width="120" Margin="4,4,-96,4" Click="btnSelectFolder_Click"/>

        <!-- Output type -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="LVGL image type:" Style="{StaticResource SectionLabel}"/>
        <ComboBox Grid.Row="1" Grid.Column="1" x:Name="cbType" Margin="4,4" ToolTip="RGB332 / RGB888 are placeholders and not available yet"/>
        <CheckBox Grid.Row="1" Grid.Column="1" x:Name="cbIgnoreExistedFile" Content="Ignore existing .bin" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="4,-20,4,4"/>

        <!-- Start -->
        <Button Grid.Row="2" Grid.Column="0" x:Name="btnStart" Content="Start" Height="32" HorizontalAlignment="Left" Width="100" Click="btnStart_Click" ToolTip="Start conversion"/>

        <!-- Handle / delete unhandled -->
        <Button Grid.Row="3" Grid.Column="0" x:Name="btnHandle" Content="Handle" Height="32" HorizontalAlignment="Left" Width="100" Click="btnHandle_Click" ToolTip="Delete files that failed to convert"/>

        <!-- Status tip -->
        <TextBlock Grid.Row="4" Grid.Column="0" x:Name="txtTip" Text="" Margin="8,6" TextWrapping="Wrap" VerticalAlignment="Center"/>

        <!-- Progress -->
        <TextBlock Grid.Row="6" Grid.Column="0" x:Name="txtProgress" Text="0%" Margin="8,4" Width="40" VerticalAlignment="Center"/>
        <ProgressBar Grid.Row="6" Grid.Column="1" x:Name="gdProgress" Height="20" Margin="4,4" Minimum="0" Value="0"/>
    </Grid>
</Window>
